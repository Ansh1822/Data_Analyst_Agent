# Free key from https://console.groq.com/keys
GROQ_API_KEY=your-key-here
# Fallback if you hit rate limits: llama-3.1-8b-instant
ANALYST_MODEL=openai/gpt-oss-120b
# local = run generated code in a subprocess (easy on Windows)
# docker = run it in a locked-down container (recommended for anything public)
SANDBOX_MODE=local
SANDBOX_IMAGE=analyst-sandbox
SANDBOX_TIMEOUT=60
MAX_FIX_ATTEMPTS=3
MAX_STEPS=5
CORS_ORIGINS=http://localhost:5173
